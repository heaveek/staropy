# --- App ---
APP_ENV=development            # development | production | test
APP_NAME=Tarot Mini App
APP_TIMEZONE=Europe/Moscow     # backend-owned day boundary for limits
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Database (PostgreSQL in production) ---
DATABASE_URL=postgresql+psycopg://tarot:change_me@localhost:5432/tarot

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
ADMIN_TELEGRAM_IDS=

# --- Limits ---
FREE_READINGS_PER_DAY=1
FREE_HISTORY_LIMIT=3
QUESTION_MAX_LENGTH=500

# --- Payments (disabled by default; products are inactive until explicit activation) ---
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=telegram_stars   # telegram_stars | stub

# --- Development-only auth escape hatch. MUST be false in production. ---
ALLOW_DEV_AUTH=false
